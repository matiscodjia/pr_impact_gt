\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \textbf  {The surface/topology coupling, measured.} As the boundary drift grows, the number of spurious connected components (Betti$_0$) rises steeply: a purely ``surface'' perturbation fragments the thin arterial tree because a displacement comparable to the vessel radius pinches it off. This is why, for the drift, we report Betti$_0$ \emph  {alongside} the surface metrics rather than treating topology as a separate axis (Sec.~\ref {sec:coupling}).}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:calibtopo}{{5.1}{20}{\textbf {The surface/topology coupling, measured.} As the boundary drift grows, the number of spurious connected components (Betti$_0$) rises steeply: a purely ``surface'' perturbation fragments the thin arterial tree because a displacement comparable to the vessel radius pinches it off. This is why, for the drift, we report Betti$_0$ \emph {alongside} the surface metrics rather than treating topology as a separate axis (Sec.~\ref {sec:coupling})}{figure.caption.19}{}}
