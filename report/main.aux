\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces \textbf  {The bias axis $\mu $ on a real pulmonary-artery tree} at the operating point $r{=}1,p{=}0.5$. Red = removed voxels (boundary receded), blue = added (boundary advanced). From left to right $\mu =-1,\,-0.5,\,0,\,+0.5,\,+1$: under-segmentation $\to $ balanced jitter $\to $ over-segmentation. The agreement (clDice, NSD@0.5) annotated under each view stays in the inter-observer window at the trained points $\mu {=}{\pm }0.5$ (Table~\ref {tab:calib}). A single parameter spans augmentation ($\mu =0$, Q2) and learnable bias ($\mu \neq  0$, Q3).}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:musweep}{{3.2}{12}{\textbf {The bias axis $\mu $ on a real pulmonary-artery tree} at the operating point $r{=}1,p{=}0.5$. Red = removed voxels (boundary receded), blue = added (boundary advanced). From left to right $\mu =-1,\,-0.5,\,0,\,+0.5,\,+1$: under-segmentation $\to $ balanced jitter $\to $ over-segmentation. The agreement (clDice, NSD@0.5) annotated under each view stays in the inter-observer window at the trained points $\mu {=}{\pm }0.5$ (Table~\ref {tab:calib}). A single parameter spans augmentation ($\mu =0$, Q2) and learnable bias ($\mu \neq 0$, Q3)}{figure.caption.8}{}}
\newlabel{fig:musweep@cref}{{[figure][2][3]3.2}{[1][12][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces \textbf  {Bias axis $\mu $ on an axial cross-section} (companion to Fig.~\ref {fig:musweep}). Left to right, the contour recedes ($\mu {<}0$, net red, under-segmentation), oscillates with zero mean ($\mu {=}0$, balanced red/blue), then advances ($\mu {>}0$, net blue, over-segmentation). The transition from red-dominated to blue-dominated is the visual reading of the signed volume change $\Delta V$, the direction-sensitive instrument of Table~\ref {tab:pairing}.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:musweep2d}{{3.3}{12}{\textbf {Bias axis $\mu $ on an axial cross-section} (companion to Fig.~\ref {fig:musweep}). Left to right, the contour recedes ($\mu {<}0$, net red, under-segmentation), oscillates with zero mean ($\mu {=}0$, balanced red/blue), then advances ($\mu {>}0$, net blue, over-segmentation). The transition from red-dominated to blue-dominated is the visual reading of the signed volume change $\Delta V$, the direction-sensitive instrument of Table~\ref {tab:pairing}}{figure.caption.9}{}}
\newlabel{fig:musweep2d@cref}{{[figure][3][3]3.3}{[1][12][]12}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.3}The bias axis $\mu $}{12}{section.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces \textbf  {The bias axis in 3D, one operating point per render.} From under-segmentation ($\mu {<}0$, red-dominated: the boundary recedes and thin vessels are pinched off) through balanced jitter ($\mu {=}0$) to over-segmentation ($\mu {>}0$, blue-dominated: the boundary advances and vessels merge). A single continuous knob spans the augmentation regime (Q2) and the learnable-bias regime (Q3); rendered individually, the monotone red$\to $blue shift is the signed $\Delta V$ made visible on the real tree.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ind3d-mu}{{3.4}{13}{\textbf {The bias axis in 3D, one operating point per render.} From under-segmentation ($\mu {<}0$, red-dominated: the boundary recedes and thin vessels are pinched off) through balanced jitter ($\mu {=}0$) to over-segmentation ($\mu {>}0$, blue-dominated: the boundary advances and vessels merge). A single continuous knob spans the augmentation regime (Q2) and the learnable-bias regime (Q3); rendered individually, the monotone red$\to $blue shift is the signed $\Delta V$ made visible on the real tree}{figure.caption.10}{}}
\newlabel{fig:ind3d-mu@cref}{{[figure][4][3]3.4}{[1][12][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces \textbf  {Signatures of the noise families} (3D). Voxel counts in the titles expose the bias: \texttt  {distal\_omission}, \texttt  {distal\_truncation} and \texttt  {homogeneous\_morpho} only remove ($-N/+0$, biased), whereas \texttt  {boundary\_drift} at $\mu =0$ removes and adds in near-equal amounts (unbiased) -- the visual fingerprint of zero-mean noise (cf.~Heller et al.~\cite  {heller2018imperfect}).}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:families}{{3.5}{13}{\textbf {Signatures of the noise families} (3D). Voxel counts in the titles expose the bias: \texttt {distal\_omission}, \texttt {distal\_truncation} and \texttt {homogeneous\_morpho} only remove ($-N/+0$, biased), whereas \texttt {boundary\_drift} at $\mu =0$ removes and adds in near-equal amounts (unbiased) -- the visual fingerprint of zero-mean noise (cf.~Heller et al.~\cite {heller2018imperfect})}{figure.caption.11}{}}
\newlabel{fig:families@cref}{{[figure][5][3]3.5}{[1][12][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces \textbf  {The same four families on an axial cross-section} (companion to Fig.~\ref {fig:families}). The slice view makes the \emph  {mechanism} legible per family: \texttt  {distal\_omission} deletes whole thin branches (red, radius-gated); \texttt  {distal\_truncation} files terminal segments; \texttt  {homogeneous\_morpho} erodes the wall uniformly (unrealistic control); \texttt  {boundary\_drift} at $\mu {=}0$ perturbs the contour both inward (red) and outward (blue) with zero mean. Only \texttt  {boundary\_drift} produces added voxels -- the operational definition of unbiased noise.}}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:families2d}{{3.6}{14}{\textbf {The same four families on an axial cross-section} (companion to Fig.~\ref {fig:families}). The slice view makes the \emph {mechanism} legible per family: \texttt {distal\_omission} deletes whole thin branches (red, radius-gated); \texttt {distal\_truncation} files terminal segments; \texttt {homogeneous\_morpho} erodes the wall uniformly (unrealistic control); \texttt {boundary\_drift} at $\mu {=}0$ perturbs the contour both inward (red) and outward (blue) with zero mean. Only \texttt {boundary\_drift} produces added voxels -- the operational definition of unbiased noise}{figure.caption.12}{}}
\newlabel{fig:families2d@cref}{{[figure][6][3]3.6}{[1][12][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces \textbf  {The two retained families rendered individually in 3D} on the PARSE\_0001 arterial tree (red = removed, blue = added). Omission (left) is purely subtractive and deletes whole distal branches -- a change of \emph  {topology}. Drift at $\mu {=}0$ (right) perturbs the \emph  {surface} with balanced red and blue, the geometric fingerprint of a zero-mean, unbiased error. Isolating each family in its own render makes the mechanism unambiguous.}}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ind3d-families}{{3.7}{15}{\textbf {The two retained families rendered individually in 3D} on the PARSE\_0001 arterial tree (red = removed, blue = added). Omission (left) is purely subtractive and deletes whole distal branches -- a change of \emph {topology}. Drift at $\mu {=}0$ (right) perturbs the \emph {surface} with balanced red and blue, the geometric fingerprint of a zero-mean, unbiased error. Isolating each family in its own render makes the mechanism unambiguous}{figure.caption.13}{}}
\newlabel{fig:ind3d-families@cref}{{[figure][7][3]3.7}{[1][12][]15}{}{}{}}
